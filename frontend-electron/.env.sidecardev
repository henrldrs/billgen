# Paired with scripts/dev_desktop_api.py — a throwaway desktop-mode API on 8010.
#
# Why this exists: lib/api.ts asks Tauri for the sidecar port and falls back to
# VITE_API_URL when there is no Tauri, which is what makes the desktop app
# runnable in a plain browser. Without this the fallback is :8000 — the SaaS
# API, where /auth/desktop-bootstrap 404s because desktop_mode is off, so the
# app cannot boot. Loaded only by `vite --mode sidecardev`.
VITE_API_URL=http://127.0.0.1:8010

# Look at what a beta tester will see, not what a developer sees. Without this
# a dev server shows the whole IA, scaffold pages included.
VITE_BILLGEN_EXPOSURE=wired
