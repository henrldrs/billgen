        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n\n%% ============================\n%% FRONTEND LAYER\n%% ============================\nsubgraph FRONTEND[\&quot;Frontend Layer (React Web SaaS + Electron Desktop)\&quot;]\n    A1[\&quot;React Web SaaS\\n- UI only\\n- Token store\\n- API client\&quot;]\n    A2[\&quot;Electron Desktop (Tauri)\\n- Local UI\\n- Calls API or local SQLite\&quot;]\n    A3[\&quot;@billgen/ui\\nShared UI Kit\&quot;]\nend\n\n%% ============================\n%% NETWORK EDGE\n%% ============================\nN1[\&quot;HTTPS / JSON\\nJWT Auth Header\\nOrg-ID Routing\&quot;]\n\n%% ============================\n%% API LAYER\n%% ============================\nsubgraph API[\&quot;FastAPI Layer\&quot;]\n    R1[\&quot;Routers\\n/auth\\n/clients\\n/products\\n/invoices\\n/credit-notes\\n/reports\&quot;]\n    M1[\&quot;Middleware\\n- Auth (JWT)\\n- Tenant Isolation\\n- Logging\\n- Rate Limit\&quot;]\n    D1[\&quot;Dependencies\\nget_db()\\nget_current_user()\\nget_org_ctx()\&quot;]\n    I1[\&quot;Integrations\\nStripe\\nEmail Provider\\nStorage Backend (S3/MinIO)\&quot;]\nend\n\n%% ============================\n%% CORE LAYER\n%% ============================\nsubgraph CORE[\&quot;Core Layer (Pure Python)\&quot;]\n    C1[\&quot;Domain Models\\nInvoice\\nClient\\nProduct\\nTax\\nPayment\\nAuditLog\&quot;]\n    C2[\&quot;Services\\nInvoiceService\\nCreditNoteService\\nPDFService\\nReportingService\&quot;]\n    C3[\&quot;Rules\\nVAT\\nDiscounts\\nNumbering\\nLegal Mentions\&quot;]\n    C4[\&quot;Repository Ports\\nAbstract Interfaces\&quot;]\n    C5[\&quot;Utils\\nMoney\\nDates\\nCSV\\nFile Signing\&quot;]\nend\n\n%% ============================\n%% DB LAYER\n%% ============================\nsubgraph DB[\&quot;Database Layer\&quot;]\n    DB1[\&quot;SQLAlchemy ORM Models\&quot;]\n    DB2[\&quot;Repository Implementations\\n(ORM adapters)\&quot;]\n    DB3[\&quot;Alembic Migrations\&quot;]\n    DB4[\&quot;Seed Data\&quot;]\nend\n\n%% ============================\n%% STORAGE\n%% ============================\nsubgraph STORAGE[\&quot;Storage Layer\&quot;]\n    S1[\&quot;PostgreSQL / SQLite\&quot;]\n    S2[\&quot;S3 / MinIO\\nPDFs, Logos, Backups\&quot;]\nend\n\n%% ============================\n%% NETWORK CONNECTIONS\n%% ============================\nA1 --&gt; N1\nA2 --&gt; N1\n\nN1 --&gt; R1\nR1 --&gt; M1\nM1 --&gt; D1\nD1 --&gt; C2\n\nC2 --&gt; C4\nC4 --&gt; DB2\nDB2 --&gt; DB1\nDB1 --&gt; S1\n\nC2 --&gt; I1\nI1 --&gt; S2\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="LEa4z-jx8n3dWPIqyIbO-1">
