{
  "name": "billgen-component-library",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Isolated preview/typecheck tooling for the component library staged here. Not part of the real @billgen/ui build — see README.md.",
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
