{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "api.main:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "saas",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace",
        "@billgen/saas"
      ],
      "port": 5173
    },
    {
      "name": "api-desktop",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "scripts/dev_desktop_api.py"
      ],
      "port": 8010
    },
    {
      "name": "saas-desktop",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:desktop",
        "--workspace",
        "@billgen/saas"
      ],
      "port": 5183
    },
    {
      "name": "billgen-site",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "../billgen_presale_website",
        "run",
        "dev",
        "--",
        "--port",
        "3007"
      ],
      "port": 3007
    },
    {
      "name": "docs",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8099",
        "--directory",
        "docs"
      ],
      "port": 8099
    }
  ]
}