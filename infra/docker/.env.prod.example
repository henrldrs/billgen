# BillGen — production environment (ADR-0004).
#
# Copy to infra/docker/.env.prod ON THE VPS ONLY. Never commit the real file:
#   install -m 600 -o root -g root .env.prod /path/to/repo/infra/docker/.env.prod
#
# Every variable below maps to a real field in api/config.py Settings, or is
# consumed by compose/Caddy. Settings uses extra="ignore", so a variable that
# does not exist in code fails silently — do not add aspirational entries here.
# (The repo-root .env.example still carries several of those; ADR-0004 has its
# rewrite as a task.)

# ── api/config.py Settings ──────────────────────────────────────────────────
# MUST be production: the API then refuses to boot on the dev JWT secret, a
# secret under 32 bytes, or desktop_mode (api/config.py validate_for_boot).
ENVIRONMENT=production

# Managed Postgres, off-box. psycopg[binary] is already a billgen-db dependency.
# Use sslmode=require unless the provider mandates verify-full.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/billgen?sslmode=require

# Generate once, never reuse a dev value:  openssl rand -base64 48
# Rotating this invalidates every access and refresh token in circulation.
JWT_SECRET=
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# The SPA is same-origin behind Caddy, so CORS is not load-bearing here — set
# it to the real origin anyway so a stray cross-origin caller is rejected
# rather than silently allowed. A localhost entry here logs a boot warning.
CORS_ORIGINS=https://app.billgen.be

# Per-IP sliding window. Honest only while uvicorn runs --workers 1: the window
# lives in process memory (api/middleware/ratelimit.py).
RATE_LIMIT_PER_MINUTE=120

# Must stay false: desktop bootstrap mints a credential-less account, and a
# production start refuses to boot if this is true.
DESKTOP_MODE=false

# ── compose / Caddy ─────────────────────────────────────────────────────────
DOMAIN=app.billgen.be
ACME_EMAIL=h.enri@outlook.com
GHCR_OWNER=
BILLGEN_TAG=latest
