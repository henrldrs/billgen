<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<title>{{ doc_title }} {{ reference_display }}</title>
<style>
  @page { size: A4; margin: 20mm; }
  body { font-family: Helvetica, Arial, sans-serif; color: #222; font-size: 10pt; }
  h2 { font-size: 18pt; letter-spacing: 3px; margin: 0 0 2px; }
  .head { margin-bottom: 28px; }
  .muted { color: #666; }
  .blocks { display: flex; justify-content: space-between; margin-bottom: 24px; }
  table.lines { width: 100%; border-collapse: collapse; }
  table.lines th { text-align: left; padding: 6px 4px; border-bottom: 1px solid #222; font-weight: 600; }
  table.lines td { padding: 6px 4px; border-bottom: 1px solid #eee; }
  td.num, th.num { text-align: right; white-space: nowrap; }
  .totals { margin-top: 12px; margin-left: auto; width: 40%; }
  .totals table { width: 100%; border-collapse: collapse; }
  .totals td { padding: 3px 4px; }
  .totals .grand td { font-weight: 700; border-top: 1px solid #222; }
  .mentions { margin-top: 16px; font-size: 8.5pt; color: #555; }
  footer { margin-top: 24px; font-size: 8.5pt; color: #666; }
  .draft-watermark { position: fixed; top: 42%; left: 0; right: 0; text-align: center;
    transform: rotate(-30deg); font-size: 44pt; font-weight: bold; letter-spacing: 4px;
    color: rgba(200, 0, 0, 0.18); z-index: 0; pointer-events: none; }
  .draft-note { color: #c00000; font-weight: 700; }
</style>
</head>
<body>
{% if is_draft %}<div class="draft-watermark">{{ watermark }}</div>{% endif %}
<div class="head">
  <h2>{{ doc_title }}</h2>
  <div class="muted">Nr. {{ reference_display }} · Datum: {{ issue_date_fmt }}{% if due_date_fmt %} · Vervaldatum: {{ due_date_fmt }}{% endif %}</div>
  {% if is_draft %}<div class="draft-note">{{ watermark }}</div>{% endif %}
</div>

<div class="blocks">
  <div>
    <strong>{{ company.name }}</strong><br>
    {% if company.address_line1 %}{{ company.address_line1 }}<br>{% endif %}
    {% if company.postal_code or company.city %}{{ company.postal_code or "" }} {{ company.city or "" }}<br>{% endif %}
    {% if company.vat_number %}BTW: {{ company.vat_number }}{% endif %}
  </div>
  <div>
    <strong>{{ client.name }}</strong><br>
    {% if client.address_line1 %}{{ client.address_line1 }}<br>{% endif %}
    {% if client.postal_code or client.city %}{{ client.postal_code or "" }} {{ client.city or "" }}<br>{% endif %}
    {% if client.vat_number %}BTW: {{ client.vat_number }}{% endif %}
  </div>
</div>

<table class="lines">
  <thead>
    <tr><th>Omschrijving</th><th class="num">Aantal</th><th class="num">Prijs</th><th class="num">Totaal</th></tr>
  </thead>
  <tbody>
    {% for row in rows %}
    <tr>
      <td>{{ row.description }}</td>
      <td class="num">{{ row.quantity }}</td>
      <td class="num">{{ row.unit_price_fmt }}</td>
      <td class="num">{{ row.net_fmt }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>

<div class="totals">
  <table>
    <tr><td>Subtotaal</td><td class="num">{{ totals.net_fmt }}</td></tr>
    {% for v in totals.vat_rows %}
    <tr><td>BTW {{ v.rate }}%</td><td class="num">{{ v.amount_fmt }}</td></tr>
    {% endfor %}
    <tr class="grand"><td>Totaal</td><td class="num">{{ totals.ttc_fmt }}</td></tr>
  </table>
</div>

{% if invoice.comments %}<p>{{ invoice.comments }}</p>{% endif %}

{% if mentions %}
<div class="mentions">
  {% for m in mentions %}<div>{{ m }}</div>{% endfor %}
</div>
{% endif %}

<footer>
  {% if company.iban %}IBAN: {{ company.iban }}{% if company.bic %} · BIC: {{ company.bic }}{% endif %}{% endif %}
  {% if invoice.payment_terms %}<div>{{ invoice.payment_terms }}</div>{% endif %}
</footer>
</body>
</html>
