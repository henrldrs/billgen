# BillGen — local development environment.
#
# Every variable here maps to a real field on api/config.py Settings — one
# exception, marked where it appears, is read by core/ directly. Settings
# uses extra="ignore", so anything that is NOT a real field is silently
# accepted and silently does nothing — which is how this file previously came
# to advertise API_HOST, API_PORT, STORAGE_BACKEND, S3_*, STRIPE_* and
# POSTMARK_SERVER_TOKEN, none of which the code has ever read. Do not add a
# variable here until the field exists; add it in the same change as the code.
#
# For the hosted stack see infra/docker/.env.prod.example (ADR-0004).

# dev | production. Hosted deployments MUST set production: the API then
# refuses to boot on the dev JWT secret, a secret under 32 bytes, or
# desktop_mode, and warns on dev CORS origins / SQLite (validate_for_boot).
ENVIRONMENT=dev

# Dev = SQLite. Prod SaaS = Postgres (psycopg is already a billgen-db dep).
DATABASE_URL=sqlite:///./var/billgen.dev.db
# DATABASE_URL=postgresql+psycopg://billgen:billgen@localhost:5432/billgen

# Auth (JWT). The dev default in api/config.py is fine locally and refuses to
# boot under ENVIRONMENT=production. Real value: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# Comma-separated. The SaaS dev shell runs on 5173.
CORS_ORIGINS=http://localhost:5173

# Per-IP sliding window; 0 disables it. The window lives in process memory
# (api/middleware/ratelimit.py), so it is only honest at one worker.
RATE_LIMIT_PER_MINUTE=120

# Failed sign-ins per IP per minute, drawn from a bucket of its own so
# /auth/login is not rated like browsing (SEC-20). Only FAILURES count, so a
# correct password can never throttle a paying customer. Small on purpose:
# 120/min on the general bucket would be 172,800 guesses a day from one
# address. Per-account lockout is the other half and needs T-12.
AUTH_FAILURES_PER_MINUTE=10

# Enables POST /auth/desktop-bootstrap (single local user, no credentials).
# The desktop sidecar sets this itself; it must never be true on a host.
DESKTOP_MODE=false

# The one variable read by core/pdf/renderer.py directly rather than through
# Settings — core/ cannot import api/. Unset, the PDF engine is the Edge that
# Windows already has, found through the registry (T-21); elsewhere it is
# Playwright's Chromium. Set it to a Chromium-family executable to print
# through that one instead. A path that does not exist means "no browser",
# never "some other browser".
# BILLGEN_PDF_BROWSER=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe

# ─────────────────────────────────────────────────────────────────────────────
# Not yet implemented. The following have NO Settings field and no code reads
# them — they are recorded here only as a map of what a hosted launch still
# needs (HANDOFF §9, ADR-0004). Setting one today does nothing at all.
#
#   Storage       STORAGE_BACKEND / S3_*     — PDFs render on demand; nothing
#                                              is persisted to object storage.
#   Billing       STRIPE_SECRET_KEY, …       — Phase 10. The `stripe` dep is
#                                              declared; no code calls it.
#   Email         POSTMARK_SERVER_TOKEN, …   — no transport exists, which is
#                                              why there is no password reset.
#   Licensing     LICENSE_PUBLIC_KEY_PATH    — desktop/licensing.py takes the
#                                              key as an argument today.
#   Observability SENTRY_DSN                 — ADR-0004.
# ─────────────────────────────────────────────────────────────────────────────
