# API
API_HOST=127.0.0.1
API_PORT=8000

# Database — dev = SQLite; prod SaaS = Postgres
DATABASE_URL=sqlite:///./var/billgen.dev.db
# DATABASE_URL=postgresql+psycopg://billgen:billgen@localhost:5432/billgen

# Auth (JWT)
JWT_SECRET=change-me-in-real-envs
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# Storage backend: local | s3 | minio
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./var/storage
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Stripe (SaaS)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (SaaS)
POSTMARK_SERVER_TOKEN=

# Desktop license verification
LICENSE_PUBLIC_KEY_PATH=./var/keys/license.pub
